# PS27 - Railway Maintenance Block Optimizer - Backend Foundation (Part 1)
#
# Copy this file to `.env` and fill in real values locally if needed.
# NEVER commit real credentials. All values here are placeholders.
#
# The application is configured via Spring profiles:
#   - default (no profile): in-memory H2 database, synthetic sample data, no credentials required
#   - spring.profiles.active=postgres : connects to a PostgreSQL/Supabase database using the
#     variables below.

# --- PostgreSQL / Supabase connection (only needed for the "postgres" profile) ---
DB_URL=jdbc:postgresql://<host>:<port>/<database>
DB_USERNAME=<username>
DB_PASSWORD=<password>

# --- Optional tuning (keep defaults unless needed) ---
# DB_POOL_MAX_SIZE=10
# DB_SCHEMA=public
# JPA_DDL_AUTO=update

# --- Conflict detection (Part 4) tuning (defaults shown) ---
# CONFLICT_MIN_GAP_DAYS=1
# CONFLICT_MAX_DAILY_WORK_MINUTES=720

# --- Block optimization (Part 5) tuning (defaults shown) ---
# OPTIMIZATION_ALGORITHM=deterministic-greedy-v1
# OPTIMIZATION_MAX_CONCURRENT_BLOCKS=5
# OPTIMIZATION_PERSIST_BLOCK_STATUS=SCHEDULED

# --- Supabase (NOT used in Part 1; reserved for later cloud deployment) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
